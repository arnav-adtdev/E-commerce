doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Bootstrap Image Slider
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css")
        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")       
        
        style.


            /* Styled Info Box */
            .container .row.align-items-center {
                background: linear-gradient(to right, #ffcc00, #ff6699, #66ccff);
                text-align: center;
                max-width: 500px;
            }

            /* Carousel Customization */
            .carousel {
                margin: auto;
                border-radius: 10px;
                overflow: hidden;
                box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.2);
            }

            /* Image Styling */
            .carousel-inner img {
                border-radius: 10px;
                object-fit: cover;
                height: 367px; 
                width: 100%;

            }

            /* Styled Navigation Buttons */
            .carousel-control-prev-icon, .carousel-control-next-icon {
                background-color: rgba(0, 0, 0, 0.5);
                border-radius: 50%;
                padding: 10px;
            }

            /* Responsive Fixes */
            @media (max-width: 768px) {
                /* Ensure images scale properly */
                .carousel-inner img {
                    width: 100%;
                    height: 150px;
                    object-fit: cover;
                }

                /* Improve navigation button sizes */
                .carousel-control-prev-icon, 
                .carousel-control-next-icon {
                    padding: 15px;
                    background-color: rgba(0, 0, 0, 0.6);
                }

                /* Adjust carousel indicators */
                .carousel-indicators {
                    bottom: -15px; /* Prevent overlapping */
                    justify-content: center;
                }

                /* Enable horizontal scrolling */
                .container-fluid.p-0 {
                    overflow-x: auto;
                    scroll-behavior: smooth;
                    white-space: nowrap;
                }
            }


            @media (min-width: 768px) {
                .hidden-lg {
                    display: none;
                }
            }

    body
