doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        title Bootstrap Image Slider
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css")
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css")
        script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js")       
        
        style.


            /* Styled Info Box */
            .container .row.align-items-center {
                background: linear-gradient(to right, #ffcc00, #ff6699, #66ccff);
                text-align: center;
                max-width: 500px;
            }

            /* Carousel Customization */
            .carousel {
                //- max-width: 800px;
                margin: auto;
                border-radius: 10px;
                overflow: hidden;
                box-shadow: 0px 6px 12px rgba(0, 0, 0, 0.2);
            }

            /* Image Styling */
            .carousel-inner img {
                border-radius: 10px;
                object-fit: cover;
            }

            /* Styled Navigation Buttons */
            .carousel-control-prev-icon, .carousel-control-next-icon {
                background-color: rgba(0, 0, 0, 0.5);
                border-radius: 50%;
                padding: 10px;
            }

            /* Responsive Fixes */
            @media (max-width: 768px) {
                .container .row.align-items-center {
                    flex-direction: column;
                }
                .carousel-inner img {
                    height: 150px; 
                    object-fit: cover;
                }
                
            }
            @media (min-width: 768px) {
                .hidden-lg {
                    display: none;
                }
            }

    body
        .container.hidden-lg
            .row.align-items-center
                .col-auto
                    img(src="/img/car.png", alt="bus" style="width: 35px; margin-right: 0.5rem;")
                    | DELIVERY CHARGE 40RS ON EVERY ORDER


        .container-fluid.p-0 
            .carousel.slide#imageSlider(data-bs-ride="carousel")
                .carousel-indicators
                    button(type="button" data-bs-target="#imageSlider" data-bs-slide-to="0" class="active")
                    button(type="button" data-bs-target="#imageSlider" data-bs-slide-to="1")
                    button(type="button" data-bs-target="#imageSlider" data-bs-slide-to="2")
                    button(type="button" data-bs-target="#imageSlider" data-bs-slide-to="3")
                    button(type="button" data-bs-target="#imageSlider" data-bs-slide-to="4")
                    button(type="button" data-bs-target="#imageSlider" data-bs-slide-to="5")
                    button(type="button" data-bs-target="#imageSlider" data-bs-slide-to="6")
                    button(type="button" data-bs-target="#imageSlider" data-bs-slide-to="7")
                    button(type="button" data-bs-target="#imageSlider" data-bs-slide-to="8")

                .carousel-inner
                    .carousel-item.active
                        img(src="/slider/slider1.png" class="d-block w-100" alt="Scenic landscape view")
                    .carousel-item
                        img(src="/slider/slide2.jpg" class="d-block w-100" alt="Sunset over the ocean")
                    .carousel-item
                        img(src="/slider/slide3.jpg" class="d-block w-100" alt="Mountain peak with clouds")
                    .carousel-item
                        img(src="/slider/slide4.jpg" class="d-block w-100" alt="City skyline at night")
                    .carousel-item
                        img(src="/slider/slide5.jpg" class="d-block w-100" alt="Forest path with tall trees")
                    .carousel-item
                        img(src="/slider/slide6.jpg" class="d-block w-100" alt="Desert dunes with shadows")
                    .carousel-item
                        img(src="/slider/slide7.jpg" class="d-block w-100" alt="River flowing through valley")
                    .carousel-item
                        img(src="/slider/slide8.jpg" class="d-block w-100" alt="Snow-covered mountain view")
                    .carousel-item
                        img(src="/slider/slide9.jpg" class="d-block w-100" alt="Colorful autumn leaves in park")

                .carousel-control-prev(href="#imageSlider" role="button" data-bs-slide="prev")
                    span.carousel-control-prev-icon(aria-hidden="true")
                    span.visually-hidden Previous
                .carousel-control-next(href="#imageSlider" role="button" data-bs-slide="next")
                    span.carousel-control-next-icon(aria-hidden="true")
                    span.visually-hidden Next