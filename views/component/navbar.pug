doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1, shrink-to-fit=no')
    // Bootstrap CDN for quick styling
    link(rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css')
    link(rel='stylesheet' href='https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css')
    // Include Axios for handling requests
    script(src='https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js')
                                  
    link(rel="stylesheet", href="css/navbar.css")
    script(src="js/navbar.js") 

  body
nav.navbar.navbar-expand-lg.navbar-light(style="background-color:rgb(28, 166, 211); padding: 8px;")
    .container-fluid
        .navbar-top-row.d-flex.justify-content-between.align-items-center.w-100
            // Logo
            a.navbar-brand.d-none.d-lg-block(href="#")
                img(src="/navlogo/Apna.png" alt="Logo" width="90" height="30" style="margin-left:6rem")

            // Location & Toggle Button in Same Row
            .d-flex.align-items-center.justify-content-between.w-100
                .location-container.d-flex.align-items-center
                    i.fas.fa-map-marker-alt.me-2
                    span#location.navbar-text Loading location...
                
                button.navbar-toggler(type="button" data-bs-toggle="offcanvas" data-bs-target="#sideNavbar" aria-controls="sideNavbar")
                    span.navbar-toggler-icon

        // Search Bar - Full Width on Mobile
        .search-container.mt-3.w-100
            form#searchForm.d-flex.mx-3.position-relative(role="search" onsubmit="return openSearchPage()")
                input#searchInput.form-control(type="search" placeholder="Search for products")
                i.fas.fa-search.position-absolute

    // Offcanvas Sidebar Menu (Opens from Left)
    div.offcanvas.offcanvas-start#sideNavbar(tabindex="-1" aria-labelledby="sideNavbarLabel")
        div.offcanvas-header
            h5#sideNavbarLabel Welcome to Apna Bazaar
            button.btn-close(type="button" data-bs-dismiss="offcanvas" aria-label="Close")

        div.offcanvas-body
            ul.navbar-nav.ms-auto.gap-3
                // Cart
                li.nav-item.text-center
                    a.nav-link.d-flex.flex-column.align-items-center(href="/cart")
                        i.fas.fa-shopping-cart.fa-2x
                        span.mt-1 Cart
                
                // Profile & Account Sections
                li#accountSection.nav-item.text-center
                    a.nav-link.d-flex.flex-column.align-items-center(href="#" data-bs-toggle="modal" data-bs-target="#SignupModal")
                        i.fas.fa-user-circle.fa-2x
                        span.mt-1 Account

                
                li#profileSection.nav-item.text-center.d-none
                    a.nav-link.d-flex.flex-column.align-items-center(href="#" data-bs-toggle="modal" data-bs-target="#ProfileModal")
                        i.fas.fa-user-circle.fa-2x
                        span.mt-1#userNameNavbar Profile

    //profilemodal
    .modal#ProfileModal(tabindex="-1" aria-labelledby="ProfileModalLabel" aria-hidden="true")
        .modal-dialog.modal-dialog-centered.modal-lg
            .modal-content
                .modal-header.bg-primary.text-white
                    h5#ProfileModalLabel.modal-title User Profile
                    button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")

                .modal-body
                    // User Info Section
                    .text-center
                        i.fas.fa-user-circle.fa-4x.text-white.bg-primary.rounded-circle.p-3.mb-3
                        h4#userNameProfile User Name
                        p#userEmailProfile.text-muted user@example.com

                    hr

                    // Profile Options
                    .list-group.list-group-flush
                        a.list-group-item.list-group-item-action.d-flex.align-items-center(href="#")
                            i.fas.fa-cog.me-2.text-primary
                            span Settings
                       
                        a.list-group-item.list-group-item-action.d-flex.align-items-center(href="/getOrders")
                            i.fas.fa-history.me-2.text-success
                            span My Order
                        a.list-group-item.list-group-item-action.d-flex.align-items-center(href="/footer")
                            i.fas.fa-question-circle.me-2.text-warning
                            span Help & Support
                        a.list-group-item.list-group-item-action.d-flex.align-items-center(href="#" onclick="handleLogout()")
                            i.fas.fa-sign-out-alt.me-2.text-danger
                            span Logout

                .modal-footer.justify-content-between
                    button.btn.btn-outline-secondary(type="button" data-bs-dismiss="modal") Close
                    button.btn.btn-primary(type="button" onclick="handleSettings()") Manage Account


              
    // Signup Modal
    .modal#SignupModal(tabindex="-1" aria-labelledby="SignupModalLabel" aria-hidden="true")

      .modal-dialog
        .modal-content
          .modal-header
            h5#SignupModalLabel.modal-title Signup with OTP
            button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')

          .modal-body
            form#SignupForm
              .mb-3
                label.form-label(for='firstName') Name
                span.text-danger.ms-2 *
                .row
                  .col-md-6
                    input#firstName.form-control(type="text" placeholder="Enter Your Name" required)
                  .col-md-6
                    input#lastName.form-control(type="text" placeholder="Enter Your Last Name" required)
                  
              .mb-3
                label.form-label(for='email') Email
                span.text-danger.ms-2 *
                input#email.form-control(type="email" placeholder="yourmail@gmail.com" required)

              .mb-3
                label.form-label(for='mobile') Mobile Number
                span.text-danger.ms-2 *
                input#mobile.form-control(type="tel" placeholder="Phone Number" required pattern="[0-9]{10}" maxlength="10")

              button#sendOtpBtn.btn.btn-secondary.w-100(type="button" onclick="toggleDivs()") Send OTP

              // Upper div (initially visible)
              div#registeredDivUpper.d-flex.justify-content-between.align-items-center.mt-3
                p.text-muted.mb-0 If user already registered?
                button.btn.btn-primary(type="button" onclick="openLoginModal()") Login

              button#resendOtpBtn.btn.btn-link.d-none Resend OTP

              .mb-3.mt-3.d-none#otpSection
                label.form-label(for='otp') Enter OTP
                span.text-danger.ms-2 *
                input#otp.form-control(type="text" placeholder="Enter OTP" required maxlength="6")
              button#verifyOtpBtn.btn.btn-primary.w-100.mt-3.d-none(type="button") Verify & Signup

              // Lower div (initially hidden)
              div#registeredDivLower.d-none.d-flex.justify-content-between.align-items-center.mt-3
                p.text-muted.mb-0 If user already registered?
                button.btn.btn-primary(type="button" onclick="openLoginModal()") Login

          

    // Login Modal
    .modal#LoginModal(tabindex="-1" aria-labelledby="LoginModalLabel" aria-hidden="true")

      .modal-dialog
        .modal-content
          .modal-header
            h5#LoginModalLabel.modal-title Login with OTP
            button.btn-close(type='button' data-bs-dismiss='modal' aria-label='Close')

          .modal-body
            form#LoginForm
              .mb-3
                label.form-label(for='loginMobile') Mobile Number
                span.text-danger.ms-2 *
                input#loginMobile.form-control(type='tel' placeholder='Enter Mobile Number' required pattern="[0-9]{10}" maxlength="10")

              button#sendLoginOtpBtn.btn.btn-secondary.w-100(type='button' onclick="checkUserExists()") Send OTP

              .mb-3.mt-3.d-none#loginOtpSection
                label.form-label(for='loginOtp') Enter OTP
                span.text-danger.ms-2 *
                input#loginOtp.form-control(type='text' placeholder='Enter OTP' required maxlength="6")

              button#verifyLoginOtpBtn.btn.btn-primary.w-100.mt-3.d-none(type='button') Verify & Login

              div#loginErrorDiv.d-none.alert.alert-danger.mt-3 Role="alert" 
              | User does not exist. Please sign up first!
              
              button.btn.btn-primary(type="button" onclick="openSignupModal()") Register

script. 

    //login modal js 
    async function checkUserExists() {
        let mobileNumber = document.getElementById("loginMobile").value;
        
        if (!mobileNumber.match(/^[0-9]{10}$/)) {
            alert("Please enter a valid 10-digit mobile number.");
            return;
        }

        try {
            let response = await fetch(`/api/checkUser?mobile=${mobileNumber}`);
            let data = await response.json();

            if (data.exists) {
                sendOtp(mobileNumber);
            } else {
                document.getElementById("loginErrorDiv").classList.remove("d-none");
                document.getElementById("loginErrorDiv").innerText = "User does not exist. Please sign up first!";
            }
        } catch (error) {
            console.error("Error checking user:", error);
            alert("Something went wrong. Please try again later.");
        }
    }

    async function sendOtp(mobileNumber) {
        try {
            console.log(`Sending OTP to: ${mobileNumber}`);

            let response = await fetch(`/api/sendOtp?mobile=${mobileNumber}`);
            
            if (!response.ok) {
                throw new Error(`HTTP Error! Status: ${response.status}`);
            }

            let data = await response.json();
            console.log("API Response:", data);

            if (data.success) {
                document.getElementById("loginOtpSection").classList.remove("d-none");
            } else {
                alert("Failed to send OTP. Please try again.");
            }
        } catch (error) {
            console.error("Error sending OTP:", error);
            alert(`Something went wrong: ${error.message}`);
        }
    }


script. 

    // function to change modal
    function switchModal(currentModalId, targetModalId) {
        const currentModalEl = document.getElementById(currentModalId);
        const targetModalEl = document.getElementById(targetModalId);

        // ✅ Ensure current modal exists before trying to hide it
        if (currentModalEl) {
            const currentModalInstance = bootstrap.Modal.getInstance(currentModalEl);
            if (currentModalInstance) {
                currentModalInstance.hide();
            }
        } else {
            console.warn(`Modal with ID '${currentModalId}' does not exist.`);
        }

        // ✅ Ensure target modal exists before showing
        setTimeout(() => {
            if (targetModalEl) {
                const targetModalInstance = new bootstrap.Modal(targetModalEl);
                targetModalInstance.show();
            } else {
                console.error(`Modal with ID '${targetModalId}' does not exist.`);
            }
        }, 300); // Delay ensures smooth transition
    }

    // ✅ Open Login Modal from Signup Modal
    function openLoginModal() {
        switchModal("SignupModal", "LoginModal");
    }

    // ✅ Open Signup Modal from Login Modal
    function openSignupModal() {
        switchModal("LoginModal", "SignupModal");
    }

    // automatically reload 
    document.addEventListener("DOMContentLoaded", function () {
        updateNavbar(); // ✅ Ensure navbar updates on page load
        console.log("✅ Navbar loaded successfully!");
    });

    // ✅ Function to Save User Profile, Close Modal & Update Navbar
    function saveUserProfile(firstName, lastName, email = "") {
        let user = { name: `${firstName} ${lastName}`, email };
        localStorage.setItem("loggedInUser", JSON.stringify(user));
        updateNavbar(); // Refresh Navbar UI

        // 🔹 Close Signup Modal
        let signupModalElement = document.getElementById("SignupModal");
        let signupModal = bootstrap.Modal.getInstance(signupModalElement);
        if (signupModal) signupModal.hide();
    }

    // ✅ Function to Update Profile Modal Data
    function updateProfileModal() {
        let storedUser = localStorage.getItem("loggedInUser");
        let userData = storedUser ? JSON.parse(storedUser) : null;

        // Reference profile section container
        const profileSection = document.getElementById("profileSection");

        if (userData && userData.name) {
            document.getElementById("userNameProfile").textContent = userData.name;
            document.getElementById("userNameNavbar").textContent = userData.name;
            document.getElementById("userEmailProfile").textContent = userData.email || "Not Provided";

            // Ensure the profile section is visible
            if (profileSection) profileSection.style.display = "block";
        } else {
            console.error("Error loading user data. Hiding profile section.");
            
            // Hide profile section if user data is invalid
            if (profileSection) profileSection.style.display = "none";
        }
    }


    // ✅ Function to Handle Logout
    function handleLogout() {
        localStorage.removeItem("loggedInUser"); // Clear user data
        updateNavbar(); // Refresh Navbar UI
        alert("✅ Successfully logged out!");
    }

    // ✅ Function to Update Navbar Elements Based on Login State
    function updateNavbar() {
        let accountSection = document.getElementById("accountSection");
        let profileSection = document.getElementById("profileSection");
        let userNameNavbar = document.getElementById("userNameNavbar");

        if (!accountSection || !profileSection || !userNameNavbar) {
            console.warn("⚠️ Error: Navbar elements are missing.");
            return;
        }

        let storedUser = localStorage.getItem("loggedInUser");
        let userData = storedUser ? JSON.parse(storedUser) : null;

        if (userData && userData.name) {
            accountSection.classList.add("d-none"); // Hide "Account"
            profileSection.classList.remove("d-none"); // Show "Profile"
            userNameNavbar.textContent = userData.name; // Update username
            updateProfileModal(); // ✅ Update Profile Modal Data
        } else {
            accountSection.classList.remove("d-none"); // Show "Account"
            profileSection.classList.add("d-none"); // Hide "Profile"
        }
    }

    // ✅ Function to Handle Navbar Toggle Functionality for Large Screens
    document.addEventListener("DOMContentLoaded", function () {
        const navbarToggler = document.querySelector(".navbar-toggler");
        const sideNavbar = document.getElementById("sideNavbar");

        if (navbarToggler && sideNavbar) {
            navbarToggler.addEventListener("click", () => {
                if (window.innerWidth >= 992) {
                    sideNavbar.classList.toggle("show");
                }
            });
        }
    });

    // ✅ Function to Close Offcanvas Properly When Clicking Outside
    document.addEventListener("click", function (event) {
        const sideNavbar = document.getElementById("sideNavbar");
        if (sideNavbar.classList.contains("show") && !sideNavbar.contains(event.target)) {
            sideNavbar.classList.remove("show");
        }
    });

    // ✅ Event Listener for User Signup
    document.getElementById("verifyOtpBtn")?.addEventListener("click", function () {
        let firstName = document.getElementById("firstName").value.trim();
        let lastName = document.getElementById("lastName").value.trim();
        let email = document.getElementById("email").value.trim();
        
        if (firstName && lastName) {
            saveUserProfile(firstName, lastName, email);
        }
    });

