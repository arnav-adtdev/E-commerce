doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Payment Options
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    script(src="https://checkout.razorpay.com/v1/checkout.js") 
    script(src="/js/payment.js") 
    link(rel="stylesheet", href="/css/payment.css")

  body
    .container.mt-5
      h1.text-center.text-primary.mb-4 Payment Options

      .row.g-4
        //- UPI Payment
        .col-md-6
          .card.p-4
            h3.text-dark Pay via UPI
            .d-flex.align-items-center
              input#upi-id.form-control.me-2(type="text", placeholder="Enter your UPI ID (e.g., yourid@upi)")
              button.btn.btn-info.btn-md#verify-upi(type="button") Verify
            br
            button.btn.btn-primary.btn-lg.w-100#pay-upi(type="button" disabled) Pay via UPI

        //- Razorpay Card Payment
        .col-md-6
          .card.p-4
            h3.text-dark Pay with Credit/Debit Card
            button.btn.btn-success.btn-lg.w-100#pay-card(type="button") Pay via Card

        //- QR Code Payment
        .col-md-6
          .card.p-4
            h3.text-dark Scan to Pay (QR Code)
            button.btn.btn-warning.btn-lg.w-100#pay-qr(type="button") Pay via QR Code

        //- Cash on Delivery (COD)
        .col-md-6
          .card.p-4
            h3.text-dark Pay on Delivery (COD)
            button.btn.btn-secondary.btn-lg.w-100#pay-cod(type="button") Cash on Delivery

      // QR Code Modal
      .modal.fade#qrModal(tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true")
        .modal-dialog
          .modal-content
            .modal-header
              h5.modal-title.text-danger#qrModalLabel Total Amount
              button.btn-close(data-bs-dismiss="modal" aria-label="Close")
            .modal-body.text-center
              h5 Scan QR code using BHIM or Your <br>preferred UPI app
              div.d-flex.justify-content-center.align-items-center.payment-icons
                img(src="https://cdn.worldvectorlogo.com/logos/google-pay-2.svg", alt="Google Pay", width="40")
                img(src="https://cdn.worldvectorlogo.com/logos/phonepe-1.svg", alt="PhonePe", width="40")
                img(src="https://sc.filehippo.net/images/t_app-icon-l/p/fe0e8ca6-a4f1-11e6-87cf-00163ed833e7/1148601929/paytm-logo", alt="Paytm", width="40")
                img(src="https://www.uxdt.nic.in/wp-content/uploads/2020/06/BHIM_Preview.png?x76268", alt="BHIM Pay", width="40")

              img.img-fluid#qr-image(src="/img/qr.jpg", alt="Scan to Pay")
              h4.mt-3#countdown This QR code will expire in: 5:00
