doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Cart
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css")
    link(rel="stylesheet", href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css")

    style.
      .cart-img {
          width: 80px;
          height: 80px;
          object-fit: cover;
          border-radius: 8px;
          transition: transform 0.3s ease-in-out;
      }
      .cart-img:hover { transform: scale(1.1); }
      .card {
          box-shadow: 0px 4px 8px rgba(0,0,0,0.1);
          border-radius: 8px;
          padding: 20px;
      }
      th, td { text-align: center; vertical-align: middle; }
      #checkout-btn {
          font-size: 1.2rem;
          font-weight: bold;
          padding: 12px;
          width: 100%;
          max-width: 300px;
          transition: all 0.3s ease-in-out;
      }
      #checkout-btn:hover {
          background-color: #28a745;
          box-shadow: 0px 4px 8px rgba(0,0,0,0.2);
      }

  body
    .container.mt-4
      h1.mb-3.text-center.text-primary Your Shopping Cart
      .row
        .col-md-8
          .table-responsive
            table.table.table-striped.text-center
              thead.bg-dark.text-white
                tr
                  th Product Image
                  th Product Name
                  th Price
                  th Quantity
                  th Actions
              tbody#cart-items
          p#total-price.fw-bold.fs-4.mt-4.text-center.text-danger Total: ₹0

        .col-md-4
          .card.p-3
            h3.text-center.mb-3.text-dark Bill Details
            .d-flex.justify-content-between.align-items-center.fs-5.mb-2
              p.fw-bold.text-secondary Cart Value:
              span#total-price-bill.text-dark ₹0
            .d-flex.justify-content-between.align-items-center.fs-5.mb-2
              p.fw-bold.text-secondary Delivery Charge:
              span#taxes.text-dark ₹40
            .d-flex.justify-content-between.align-items-center.fs-5.mb-2
              p.fw-bold.text-secondary Sub Total:
              span#final-amount.fw-bold ₹0
            .d-flex.mb-2.align-items-right
              input#discount-checkbox.form-check-input(type="checkbox")
              label.form-check-label(for="discount-checkbox") Use Loyalty points worth Rs. 58.00
            .d-flex.justify-content-between.align-items-center.fs-5.mb-2
              p.fw-bold.text-secondary Total Amount Payable:
              span#total-payable.fw-bold ₹0
            .d-flex.flex-column.align-items-center.mt-3
              button#checkout-btn.btn.btn-success.btn-lg.mb-2 Checkout
              button#back-to-shop-btn.btn.btn-secondary.btn-lg.mt-2 Continue Shopping

    script.
      document.addEventListener("DOMContentLoaded", function () {
          const cartItemsContainer = document.getElementById("cart-items");
          const billDetailsSection = document.querySelector(".col-md-4"); // Bill Details Section
          const totalPriceElement = document.getElementById("total-price");
          const totalPriceBill = document.getElementById("total-price-bill");
          const taxesElement = document.getElementById("taxes");
          const finalAmountElement = document.getElementById("final-amount");
          const totalPayableElement = document.getElementById("total-payable");
          const discountCheckbox = document.getElementById("discount-checkbox");
          const checkoutButton = document.getElementById("checkout-btn");
          const backToShopButton = document.getElementById("back-to-shop-btn");

          let cart = JSON.parse(localStorage.getItem("cart")) || [];
          const discountAmount = 58.00;
          const deliveryCharge = 40.00;

          // ✅ Function to Update Cart UI
          function updateCart() {
              cartItemsContainer.innerHTML = "";

              if (cart.length === 0) {
                  cartItemsContainer.innerHTML = `<tr><td colspan="5" class="text-center text-muted fs-5">No items in cart</td></tr>`;
                  billDetailsSection.style.display = "none"; // 🔹 Hide bill details
                  return;
              } else {
                  billDetailsSection.style.display = "block"; // 🔹 Show bill details when cart has items
              }

              let total = 0;
              cart.forEach((item, index) => {
                  const row = document.createElement("tr");
                  row.innerHTML = `
                      <td><img src="${item.img}" alt="${item.name}" class="img-fluid cart-img"></td>
                      <td class="fw-bold">${item.name}</td>
                      <td class="text-success">₹${item.price}</td>
                      <td>
                          <div class="d-flex align-items-center justify-content-center">
                              <button class="btn btn-outline-dark btn-sm decrease-btn" data-index="${index}">-</button>
                              <span class="fs-5 mx-2">${item.quantity}</span>
                              <button class="btn btn-outline-dark btn-sm increase-btn" data-index="${index}">+</button>
                          </div>
                      </td>
                      <td>
                          <button class="btn btn-outline-danger btn-sm remove-btn" data-index="${index}">
                              <i class="bi bi-trash"></i>
                          </button>
                      </td>
                  `;
                  cartItemsContainer.appendChild(row);
                  total += item.price * item.quantity;
              });

              localStorage.setItem("cart", JSON.stringify(cart));
              updateBilling(total);
          }

          // ✅ Function to Handle Billing
          function updateBilling(total) {
              let subtotal = total + deliveryCharge;
              let finalAmount = subtotal;

              if (discountCheckbox.checked) {
                  finalAmount -= discountAmount;
              }

              totalPriceElement.innerText = `Total: ₹${total.toFixed(2)}`;
              totalPriceBill.innerText = `₹${total.toFixed(2)}`;
              taxesElement.innerText = `₹${deliveryCharge.toFixed(2)}`;
              finalAmountElement.innerText = `₹${subtotal.toFixed(2)}`;
              totalPayableElement.innerText = `₹${finalAmount.toFixed(2)}`;
          }

          // ✅ Apply Discount Logic
          discountCheckbox.addEventListener("change", function () {
              updateBilling(cart.reduce((sum, item) => sum + item.price * item.quantity, 0));
          });

          // ✅ Handle Cart Item Clicks (Increase, Decrease, Remove)
          cartItemsContainer.addEventListener("click", function (e) {
              const button = e.target.closest("button");
              if (!button) return;

              const index = button.dataset.index;
              if (index === undefined) return;

              if (button.classList.contains("remove-btn")) {
                  cart.splice(index, 1);
              } else if (button.classList.contains("increase-btn")) {
                  cart[index].quantity += 1;
              } else if (button.classList.contains("decrease-btn")) {
                  cart[index].quantity > 1 ? cart[index].quantity -= 1 : cart.splice(index, 1);
              }

              updateCart();
          });

          // ✅ Handle Checkout Process
          checkoutButton.addEventListener("click", function () {
              if (cart.length === 0) {
                  alert("⚠️ Your cart is empty!");
              } else {
                  localStorage.setItem("checkoutCart", JSON.stringify(cart));
                  window.location.href = "/checkout";
              }
          });

          // ✅ Handle Redirect for Continuing Shopping
          backToShopButton.addEventListener("click", function () {
              window.location.href = "/";
          });

          updateCart();
      });
